# ───────────────────────────────────────────────────────────────────
# SkillSync frontend — example environment variables
# Copy to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes vars prefixed with VITE_ to the client.
# ───────────────────────────────────────────────────────────────────

# Supabase project credentials (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend API base URL (default: same origin /api)
VITE_API_BASE_URL=http://localhost:8000
