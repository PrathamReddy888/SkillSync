# ───────────────────────────────────────────────────────────────────
# SkillSync backend — example environment variables
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ───────────────────────────────────────────────────────────────────

# ── Environment ────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret
# Found in Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Groq ───────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=15

# ── Piston (code execution) ────────────────────────────────────────
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_TIMEOUT_SECONDS=10

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated allowlist. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Cache ──────────────────────────────────────────────────────────
CHALLENGE_CACHE_TTL_SECONDS=300
